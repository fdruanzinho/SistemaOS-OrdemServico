# Copie este arquivo para ".env" e ajuste os valores antes de rodar o sistema.

# Chave secreta do Flask (troque por um valor aleatório em produção)
SECRET_KEY=troque-esta-chave-em-producao

# String de conexão com o banco de dados PostgreSQL.
# Formato: postgresql://usuario:senha@host:porta/nome_do_banco
# Se o servidor do sistema for o PC "servidor" da empresa, os outros PCs
# devem apontar para o IP desse servidor na rede local, por exemplo:
# DATABASE_URL=postgresql://postgres:senha@192.168.0.10:5432/ordem_servico
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ordem_servico

# Nome da empresa exibido no sistema e nos relatórios/OS impressas
EMPRESA_NOME=Minha Assistência Técnica
EMPRESA_CNPJ=00.000.000/0000-00
EMPRESA_ENDERECO=Endereço da empresa
EMPRESA_TELEFONE=(00) 0000-0000

# Chave Pix da empresa, usada para gerar o QR Code de pagamento nas telas
# de Vendas e Ordem de Serviço. Pode ser CPF/CNPJ, e-mail, telefone ou chave aleatória.
EMPRESA_PIX_CHAVE=
# Nome do titular da chave Pix (até 25 caracteres, sem acentos, é o padrão do Pix)
EMPRESA_PIX_NOME=
# Cidade do titular da chave Pix (até 15 caracteres, sem acentos)
EMPRESA_PIX_CIDADE=
